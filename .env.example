# =============================================================================
#  SmartGarage - centralna konfiguracija
#  Student: Salih Nurkovic, IB220014
#
#  Ovo je JEDINO mjesto gdje se nalaze konfiguracijske vrijednosti.
#  appsettings.json ne smije sadrzavati nijednu tajnu niti vrijednost
#  specificnu za okruzenje (upute, sekcija 3.3).
#
#  Kopiraj u .env i popuni prave vrijednosti:   cp .env.example .env
#  .env se NIKADA ne commita i NE postavlja se u GitHub Release.
# =============================================================================

# ---------- Okruzenje ----------
ASPNETCORE_ENVIRONMENT=Development
ENABLE_DEV_ENDPOINTS=true
ENABLE_SWAGGER=true
LOG_LEVEL=Information
SEED_DATA=true

# ---------- Baza podataka ----------
# Ime baze je broj indeksa BEZ prefiksa IB (upute, sekcija 3.1).
MSSQL_SA_PASSWORD=SmartGarage!2026
MSSQL_PID=Developer
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=220014
DB_USER=sa
# true  -> lokalni SQL Server sa Windows autentifikacijom (DB_HOST npr. localhost\SQLEXPRESS)
# false -> SQL Server u Docker kontejneru, prijava kroz DB_USER i MSSQL_SA_PASSWORD
DB_TRUSTED_CONNECTION=false

# ---------- API ----------
# HTTPS se namjerno NE koristi: upute (9.2) preporucuju http jer self-signed
# certifikati mogu isteci ili biti nevalidni tokom pregleda rada.
API_HTTP_PORT=5000
API_BASE_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://10.0.2.2:5000

# ---------- JWT ----------
# Minimalno 32 bajta. Generisi novi za svoje okruzenje.
JWT_KEY=PROMIJENI_ME_minimalno_32_bajta_dugacak_kljuc_1234567890
JWT_ISSUER=SmartGarage.API
JWT_AUDIENCE=SmartGarage.Clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

# ---------- RabbitMQ ----------
# localhost kada API i Worker rade izvan Dockera; u docker-compose se nadjacava imenom servisa.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_USERNAME=smartgarage
RABBITMQ_PASSWORD=smartgarage
RABBITMQ_EXCHANGE=smartgarage.events
RABBITMQ_PREFETCH_COUNT=16
# Eksponencijalni backoff, kadenca iz uputa (Dodatak A.1): 1s -> 2s -> 4s -> 8s
RABBITMQ_RETRY_COUNT=4
RABBITMQ_RETRY_BASE_SECONDS=1

# ---------- SMTP ----------
# U razvoju ide na MailHog (web UI na http://localhost:8025).
# Za pravi SMTP samo promijeni ove vrijednosti - kod se ne mijenja.
SMTP_HOST=localhost
SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@smartgarage.ba
SMTP_FROM_NAME=SmartGarage

# ---------- Stripe ----------
# Sandbox kljucevi sa https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_PROMIJENI_ME
STRIPE_PUBLISHABLE_KEY=pk_test_PROMIJENI_ME
# Dobija se iz:  stripe listen --forward-to http://localhost:5000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_PROMIJENI_ME
STRIPE_CURRENCY=eur

# ---------- Valuta ----------
# Prikazna valuta je konfigurabilna namjerno: mockup-i u prihvacenoj prijavi
# prikazuju KM, pa je prebacivanje nazad na BAM izmjena jedne linije,
# bez diranja koda.  Kurs je fiksni zakonski peg (currency board).
DISPLAY_CURRENCY=EUR
BAM_PER_EUR=1.95583

# ---------- Poslovna pravila ----------
# Garaza istovremeno servisira 5 vozila.
APPOINTMENT_MAX_CONCURRENT=5
# Termini su puni sati 08:00-16:00, kako prikazuju mockup-i.
APPOINTMENT_SLOT_MINUTES=60
APPOINTMENT_BUFFER_MINUTES=15
WORKDAY_START=08:00
WORKDAY_END=17:00
APPOINTMENT_CANCELLATION_CUTOFF_HOURS=24
APPOINTMENT_PENDING_EXPIRY_HOURS=48
BOOKING_MAX_DAYS_AHEAD=90
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
MAX_UPLOAD_SIZE_MB=5
# Folder u kojem zivi uploads/. Relativna putanja se racuna od foldera API-ja.
UPLOADS_ROOT=wwwroot

# ---------- Lozinke ----------
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NONALPHANUMERIC=true
RESET_CODE_LENGTH=6
RESET_CODE_EXPIRY_MINUTES=15

# ---------- Sistem preporuka (Content-Based Filtering) ----------
RECOMMENDER_TOP_N=5
RECOMMENDER_ALGORITHM_VERSION=cbf-1.0
SIGNAL_HALF_LIFE_DAYS=180
SIGNAL_SATURATION_COUNT=8
HISTORY_BLEND_BETA=0.7
HIGH_MILEAGE_THRESHOLD_KM=150000
OLD_VEHICLE_AGE_YEARS=10
W_ENGINE=0.20
W_MILEAGE=0.30
W_AGE=0.10
W_RATING=0.10
W_BRAND_MODEL=0.15
W_RECENT=0.50
W_DISMISS=0.40
DISMISS_COOLDOWN_DAYS=30
EXPLANATION_MIN_CONTRIBUTION=0.05
# Preko koliko procenata intervala preporuka postaje "Hitno" umjesto "Planirano"
URGENCY_HITNO_THRESHOLD=1.0

# ---------- Worker zadaci (Quartz cron, 6 polja) ----------
CRON_APPOINTMENT_REMINDER=0 0 * * * ?
CRON_SERVICE_REMINDER_SCAN=0 0 6 * * ?
CRON_PENDING_EXPIRY=0 0/30 * * * ?
CRON_PAYMENT_RECONCILIATION=0 0/15 * * * ?
CRON_RECOMMENDER_REFRESH=0 0 2 * * ?
ERROR_LOG_RETENTION_DAYS=30
